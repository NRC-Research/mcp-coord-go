<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.enkieng.mcp-coord</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/bin/mcp-coord-go</string>
    <string>-addr</string><string>127.0.0.1:7767</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.mcp-coord/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.mcp-coord/server.log</string>
</dict>
</plist>
